{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"noEmit": true,
		"target": "ES2022",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"allowJs": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"types": ["node"]
	},
	"include": ["*.ts", "../playwright.config.ts"],
	"files": ["../types.d.ts"]
}
