{
  "name": "lorex",
  "version": "2.2.0",
  "description": "Leaflet Osmand React ExpressJS Coordinates (X)\r > Remember an \"X\" marks the spot.",
  "main": "index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prebuild": "rm -rf dist/*",
    "build": "tsc && cross-env NODE_ENV=development vite build --config src/client/vite.config.js",
    "build:prod": "tsc && cross-env NODE_ENV=production vite build --config src/client/vite.config.js",
    "postbuild": "cp -R httpdocs/ dist/ && npm run unzipTiles",
    "start": "node dist/app.js",
    "start:prod": "cross-env NODE_ENV=production node dist/app.js",
    "dev": "npm run prebuild &&  npm run postbuild &&concurrently \"npm:dev:*\"",
    "dev:ts": "nodemon --config nodemon-ts.json",
    "dev:static": "nodemon --config nodemon-static.json",
    "dev:vite": "cross-env NODE_ENV=development vite build --watch --config src/client/vite.config.js",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend && npm run typecheck:e2e",
    "typecheck:backend": "tsc --noEmit -p tsconfig.json",
    "typecheck:frontend": "tsc --noEmit -p src/client/tsconfig.json",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint . --fix",
    "test": "jest",
    "test:react": "vitest run --config src/client/vitest.config.ts",
    "test:react:watch": "vitest --config src/client/vitest.config.ts",
    "pretest:e2e": "node scripts/checkE2ePrerequisites.js",
    "test:e2e": "playwright test",
    "test:data": "cross-env MODE=DEV jest --config jest.testData.config.js",
    "test:data:prod": "cross-env MODE=PROD jest --config jest.testData.config.js",
    "test:app": "jest src/tests/app.test.ts",
    "test:login": "jest src/tests/login.test.ts",
    "test:unit": "jest src/tests/unit.test.ts",
    "test:integration": "jest src/tests/integration.test.ts",
    "test:production": "jest src/tests/productionGuard.test.ts",
    "test:production:prod": "jest --config jest.production.config.js",
    "test:postClear": "npm run build",
    "postinstall": "node scripts/fix-react-leaflet-markercluster.js",
    "unzipTiles": "node scripts/unzipTiles.js"
  },
  "keywords": [],
  "author": "Type-Style",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.1.1",
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "chalk": "^4.1.2",
    "compression": "^1.8.2",
    "cross-spawn": "^7.0.6",
    "culori": "^4.0.2",
    "dotenv": "^16.6.1",
    "ejs": "^5.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "express-slow-down": "^2.1.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.2",
    "leaflet-easybutton": "^2.4.0",
    "leaflet-rotatedmarker": "^0.2.0",
    "leaflet.markercluster": "^1.5.3",
    "module-alias": "^2.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-markercluster": "^5.0.0-rc.0",
    "react-router-dom": "^7.18.4",
    "toobusy-js": "^0.5.1",
    "ts-loader": "^9.6.2"
  },
  "_moduleAliases": {
    "@src": "dist"
  },
  "sideEffects": false,
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.27.0",
    "@jest/globals": "^30.5.2",
    "@playwright/test": "^1.61.1",
    "@rolldown/plugin-babel": "^0.1.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/culori": "^4.0.1",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.18",
    "@types/leaflet-rotatedmarker": "^0.2.5",
    "@types/material-ui": "^0.21.18",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-leaflet": "^2.8.3",
    "@types/toobusy-js": "^0.5.4",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@typescript-eslint/typescript-estree": "^8.32.1",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "codemod": "^0.10.23",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.27.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.3.5",
    "eslint-plugin-functional": "^9.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "install": "^0.13.0",
    "jest": "^30.5.2",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.23",
    "postcss-nesting": "^13.0.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^8.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "@eslint/eslintrc": {
      "js-yaml": "4.3.2"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    },
    "eslint-plugin-functional": {
      "deepmerge-ts": "^8.0.2"
    }
  }
}
